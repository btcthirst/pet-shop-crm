# Neon, main branch: pooled connection string (host contains "-pooler") used by the app.
# Used on Vercel and in CI.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/petshop?sslmode=require
# Neon, main branch: direct connection string used by Prisma CLI for migrations.
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/petshop?sslmode=require
# Neon, "dev" branch: same two values for local development. When set, they take
# priority over DATABASE_URL / DIRECT_URL, so local work never touches demo data.
DATABASE_URL_DEV=postgresql://user:password@ep-yyy-pooler.region.aws.neon.tech/petshop?sslmode=require
DIRECT_URL_DEV=postgresql://user:password@ep-yyy.region.aws.neon.tech/petshop?sslmode=require
# Generate: openssl rand -base64 32
AUTH_SECRET=